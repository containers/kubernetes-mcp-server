      "title": "List Loki Label Names"
    },
    "description": "List available Loki label names for a time range. Use this before writing LogQL queries.",
    "inputSchema": {
      "properties": {
        "end": {
          "description": "End time as RFC3339, Unix timestamp, NOW, or NOW-relative expression (optional).",
          "type": "string"
        },
        "lokiName": {
          "description": "Name of the LokiStack. Use loki_list_instances to discover valid values.",
          "type": "string"
        },
        "lokiNamespace": {
          "description": "Kubernetes namespace of the LokiStack. Use loki_list_instances to discover valid values.",
          "type": "string"
        },
        "start": {
          "description": "Start time as RFC3339, Unix timestamp, NOW, or NOW-relative expression (optional).",
          "type": "string"
        },
        "tenant": {
          "description": "Loki tenant ID (X-Scope-OrgID). For LokiStack gateway modes (e.g. openshift-network) this selects the `/api/logs/v1/\u003ctenant\u003e` path; use `network` for openshift-network.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "loki_label_names",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "labels"
      ],
      "type": "object"
    },
    "title": "List Loki Label Names"
