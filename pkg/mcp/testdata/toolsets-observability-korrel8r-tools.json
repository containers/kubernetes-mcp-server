    "annotations": {
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Follow correlation paths from start objects to specific goal classes. Returns a graph of correlated classes with queries and result counts. Use for targeted queries like \"find logs for this pod\" or \"what alerts fired for this deployment?\" Start queries use \"domain:class:selector\" format; goals are class names like [\"log:application\"]. See 'korrel8r_help' for syntax.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "goals": {
          "description": "Goal classes in DOMAIN:CLASS format, e.g. log:application, alert:alert.",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "start": {
          "additionalProperties": false,
          "description": "Starting point for the search.",
          "properties": {
            "class": {
              "description": "Class of starting objects in DOMAIN:CLASS format. Required when using objects. If queries are included, they must all be of this class.",
              "type": "string"
            },
            "constraint": {
              "additionalProperties": false,
              "description": "Constrains the objects that will be included in search results.",
              "properties": {
                "end": {
                  "description": "Ignore objects with timestamps after this end time. Default: now.",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "limit": {
                  "description": "Limit total number of objects per query. Omit or set to zero for no limit.",
                  "type": [
                    "null",
                    "integer"
                  ]
                },
                "queryLimit": {
                  "description": "Limit total number of queries per class during traversal. Default: 10.",
                  "type": [
                    "null",
                    "integer"
                  ]
                },
                "start": {
                  "description": "Ignore objects with timestamps before this start time. Default: 1 hour before end.",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "totalLimit": {
                  "description": "Limit unique result objects retained across the traversal. Zero is unlimited.",
                  "type": [
                    "null",
                    "integer"
                  ]
                },
                "totalQueryLimit": {
                  "description": "Limit unique queries accepted across the traversal. This includes queries with no results, which do not appear in the result graph. The number of queries in the result may therefore be lower than this limit. Zero is unlimited.",
                  "type": [
                    "null",
                    "integer"
                  ]
                }
              },
              "type": [
                "null",
                "object"
              ]
            },
            "objects": {
              "description": "Start objects serialized as JSON. Requires class to identify the object type.",
              "items": true,
              "type": [
                "null",
                "array"
              ]
            },
            "queries": {
              "description": "Queries for starting objects in DOMAIN:CLASS:SELECTOR format.",
              "items": {
                "type": "string"
              },
              "type": [
                "null",
                "array"
              ]
            }
          },
          "type": "object"
        }
      },
      "required": [
        "goals",
        "start"
      ],
      "type": "object"
    },
