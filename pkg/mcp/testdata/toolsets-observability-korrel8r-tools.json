              "type": [
                "null",
                "integer"
              ]
            },
            "queryLimit": {
              "description": "Limit total number of queries per class during traversal. Default: 10.",
              "type": [
                "null",
                "integer"
              ]
            },
            "start": {
              "description": "Ignore objects with timestamps before this start time. Default: 1 hour before end.",
              "type": [
                "null",
                "string"
              ]
            },
            "totalLimit": {
              "description": "Limit unique result objects retained across the traversal. Zero is unlimited.",
              "type": [
                "null",
                "integer"
              ]
            },
            "totalQueryLimit": {
              "description": "Limit unique queries accepted across the traversal. This includes queries with no results, which do not appear in the result graph. The number of queries in the result may therefore be lower than this limit. Zero is unlimited.",
              "type": [
                "null",
                "integer"
              ]
            }
          },
          "type": [
            "null",
            "object"
          ]
        },
        "query": {
          "description": "Query string in the form 'domain:class:selector'. Use 'korrel8r_help' to learn query syntax for each domain.",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
